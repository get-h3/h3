# Hilo — local cache files (rebuildable)
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/graph.duckdb
.vfs/graph/.last_warm
.vfs/graph/.last_reconcile
.vfs/graph/.parse_cache.json
.vfs/.dirty

# Dagger MCP runtime state (never commit — recreated by worker sessions)
dagger.db
dagger.db-shm
dagger.db-wal

# GitReins MCP runtime state (never commit)
.gitreins/history/

# Cross-harness test artifacts
.cross-harness-results/
_run_cross_harness.sh

# Board storage (Bane directive 08-07): JSONL is the git store; .db/parquet are rebuildable caches
.coding-hermes/board/board.db
.coding-hermes/board/*.parquet
