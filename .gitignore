# Hilo — local cache files (rebuildable)
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/graph.duckdb
.vfs/graph/.last_warm
.vfs/graph/.last_reconcile
.vfs/graph/.parse_cache.json
.vfs/.dirty
# The .vfs working-state directory is rebuildable runtime state, not repo content
# (QA-H3-9: a runtime marker showed up as an untracked stray because only individual
# file names were ignored). The directory's CONTENTS are ignored — the directory itself
# is not excluded, because git cannot re-include a file whose parent directory is
# excluded. The curated artifacts .vfs/manifest.yaml and .vfs/graph/edges.jsonl are
# committed and stay tracked, and an ordinary `git add` stages them — no `-f` needed.
.vfs/*
# Curated artifact (committed) — explicitly unignored so plain `git add` works.
!.vfs/manifest.yaml
# .vfs/graph/ must be re-included as well for the negation below to reach its contents.
!.vfs/graph/
# Everything else under .vfs/graph/ is rebuildable runtime state.
.vfs/graph/*
# Curated artifact (committed) — explicitly unignored so plain `git add` works.
!.vfs/graph/edges.jsonl

# Dagger MCP runtime state (never commit — recreated by worker sessions)
dagger.db
dagger.db-shm
dagger.db-wal

# GitReins MCP runtime state (never commit)
.gitreins/history/
.gitreins/logs/
# Evaluator token-burn ledger (QA-H3-17-era runtime state, QA-H3-19): grows per
# judged task, is rebuildable from .gitreins/history verdict artifacts, and is
# host-local runtime state like the history/ and logs/ dirs above — not repo content.
.gitreins/usage.jsonl

# Cross-harness test artifacts
.cross-harness-results/
_run_cross_harness.sh

# Board storage (Bane directive 08-07): JSONL is the git store; .db/parquet are rebuildable caches
.coding-hermes/board/board.db
.coding-hermes/board/*.parquet

# Local memory-bank store dropped into the workdir by fleet tooling (H3-GAP-084).
# Foreign to this repo — a sibling DuckBrain store, never committed.
namespaces/

# Python bytecode caches (H3-GAP-099): scripts/duckbrain-tree-census.py is the
# repo's first python file, and both the acceptance command (`python3 -m
# py_compile`) and any import leave a stray scripts/__pycache__/ — rebuildable
# runtime state, never repo content (the stray-artifact class QA-H3-9 covers).
__pycache__/
